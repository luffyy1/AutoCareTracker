    "It is getting cold. Book a tire change before the first ice.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн суытып келеді. Алғашқы көктайғаққа дейін шина ауыстыруға жазылыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холодает. Запишитесь на шиномонтаж до первого гололёда."
          }
        }
      }
    },
    "It is warm enough. Winter tires wear out fast on warm roads.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн жылынды. Қысқы шина жылы жолда тез тозады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже тепло. Зимние шины быстро изнашиваются на тёплом асфальте."
          }
        }
      }
    },
