    "Keep wear percentages accurate: enter your current mileage.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тозу есебі дәл болуы үшін қазіргі жүрісті енгізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы расчёт износа был точным, введите текущий пробег."
          }
        }
      }
    },
