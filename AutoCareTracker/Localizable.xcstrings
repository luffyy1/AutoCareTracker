    "By your usual mileage it has reached its limit. Update the odometer to check.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі жүрісіңіз бойынша ресурс таусылды. Тексеру үшін жүрісті жаңартыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашему обычному пробегу ресурс выработан. Обновите пробег, чтобы проверить."
          }
        }
      }
    },
