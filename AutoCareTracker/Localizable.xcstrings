    "At your usual mileage it will need replacing in about 7 days.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі жүрісіңізбен шамамен 7 күннен кейін ауыстыру қажет болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При вашем обычном пробеге замена понадобится примерно через 7 дней."
          }
        }
      }
    },
