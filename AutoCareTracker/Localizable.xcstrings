    "No fresh forecast, using the calendar: winter season is mid-October to end of March.": {
      "extractionState": "manual",
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа болжам жоқ, күнтізбе бойынша: қысқы маусым қазанның ортасынан наурыздың соңына дейін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свежего прогноза нет, считаем по календарю: зимний сезон с середины октября до конца марта."
          }
        }
      }
    },
